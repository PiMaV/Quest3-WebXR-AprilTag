flowchart LR
  classDef once fill:#fde68a,stroke:#b45309,color:#000
  classDef live fill:#bfdbfe,stroke:#1d4ed8,color:#000
  classDef out fill:#bbf7d0,stroke:#15803d,color:#000
  CAM["Passthrough camera<br/>image and capture timestamp"]:::live
  DET["AprilTag WASM<br/>image corners"]:::live
  CAL["1 Calibration<br/>K, viewerFromCameraGL, timeOffset"]:::once
  ORI["2 Origin Lock<br/>L-angle 350/351/352 → XRAnchor"]:::once
  SINGLE["3 Single Tracking<br/>PnP + time alignment"]:::live
  MULTI["4 Multi Tracking<br/>Focus-ROI, 3 tags"]:::live
  HAND["5 Hand Coupling<br/>90 Hz rigid body"]:::live
  PRED["6 Prediction<br/>damped lead pose"]:::live
  PATH["7 Path Fusion<br/>trail smoothing"]:::live
  FENCE["8 Perimeter Fence<br/>353–359"]:::live
  OUT["Scene at XR render cadence<br/>coordinates in L-frame"]:::out
  CAM --> DET
  DET -->|"stationary reference"| CAL --> ORI
  ORI -->|"anchor frame"| OUT
  ORI -->|"reference for SCAN"| SINGLE
  DET -->|"tag corners"| SINGLE
  SINGLE -->|"track candidates"| MULTI
  MULTI -.->|"next search regions"| DET
  SINGLE -->|"optical updates"| PRED --> OUT
  SINGLE -->|"grasp confirmed"| HAND --> OUT
  HAND -->|"pending trail"| PATH
  SINGLE -->|"optical confirmation"| PATH --> OUT
  SINGLE -->|"table markers"| FENCE --> OUT
